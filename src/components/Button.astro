---
import { cn } from '../util';

interface Props {
  href: string;
  isFullWidth?: boolean;
  class?: string;
}

const { href, isFullWidth = false, class: className } = Astro.props;
const { pathname } = Astro.url;
---

<a
  class={cn(
    'px-3 py-1.5 uppercase border-3 border-green-600 hover:border-white',
    pathname === href && 'border-white',
    isFullWidth && ' block w-full text-center',
    className
  )}
  href={href}
  aria-current={pathname === href ? 'page' : 'false'}
>
  <slot />
</a>
