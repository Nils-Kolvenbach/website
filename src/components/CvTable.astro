---
import { yearsBetween } from '../util';

interface Props {
  entries: {
    company: string;
    role: string;
    description: string[];
    location: string;
    startDate: Date;
    endDate: Date;
  }[];
}

const { entries } = Astro.props;
---

<table class="w-full table-auto">
  <thead class="bg-green-600/50 px-3 sticky top-0">
    <tr>
      <th>Years</th>
      <th>Role</th>
      <th>Company</th>
      <th>Description</th>
    </tr>
  </thead>
  <tbody>
    {
      entries.map(
        ({ company, role, description, location, startDate, endDate }) => (
          <tr class="border-b-3 last:border-b-0 border-green-600/50 even:bg-green-600/10 hover:bg-black/50">
            <td class="px-3 py-1.5">
              {yearsBetween(startDate, endDate).toFixed(1)}
            </td>
            <td class="px-3 py-1.5">{role}</td>
            <td class="px-3 py-1.5">
              {company}
              <br />({location})
            </td>
            <td class="px-3 py-1.5">
              {description.map((desc) => (
                <>
                  <p class="mb-2 last:mb-0">{desc}</p>
                </>
              ))}
            </td>
          </tr>
        )
      )
    }
  </tbody>
</table>
